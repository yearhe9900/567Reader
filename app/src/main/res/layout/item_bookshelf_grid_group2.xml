<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_focused_on_tv"
    android:clickable="true"
    android:focusable="true"
    android:scrollbars="none"
    tools:ignore="UnusedAttribute">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/gl_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/bg_find_book_group"
                android:padding="2dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />

                    <com.qreader.reader.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover_9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_cover"
                android:ellipsize="end"
                android:gravity="left|bottom"
                android:includeFontPadding="false"
                android:lines="2"
                android:scrollbars="none"
                android:text="@string/book_name"
                android:textColor="@color/md_dark_primary_text"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:paddingTop="8dp"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/gl_cover"
                app:layout_constraintStart_toStartOf="@+id/gl_cover"
                app:layout_constraintEnd_toEndOf="@+id/gl_cover"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <com.qreader.reader.ui.widget.text.BadgeView
                android:id="@+id/bv_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:includeFontPadding="false"
                android:scrollbars="none"
                app:layout_constraintRight_toRightOf="@+id/gl_cover"
                app:layout_constraintTop_toTopOf="@+id/gl_cover"
                tools:ignore="RtlHardcoded" />

            <com.qreader.reader.ui.widget.anima.RotateLoading
                android:id="@+id/rl_loading"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="right"
                android:scrollbars="none"
                android:visibility="invisible"
                app:layout_constraintRight_toRightOf="@+id/gl_cover"
                app:layout_constraintTop_toTopOf="@+id/gl_cover"
                app:loading_width="2dp"
                tools:ignore="RtlHardcoded" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <View
        android:id="@+id/vw_foreground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?android:attr/selectableItemBackground"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>



